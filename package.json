{
  "name": "@jeeinn/omem",
  "version": "0.1.0-beta.7",
  "description": "A git-native personal AI memory layer: Markdown source of truth + MCP + FTS5 trigram search",
  "keywords": [
    "memory",
    "mcp",
    "markdown",
    "ai-agent",
    "fts5"
  ],
  "license": "MIT",
  "author": "jeeinn <thinkwei2012@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeeinn/omem.git"
  },
  "homepage": "https://github.com/jeeinn/omem",
  "bugs": {
    "url": "https://github.com/jeeinn/omem/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "bin": {
    "omem": "bin/omem.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "bin",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:live": "npm run build && node tests/live/verify-local.mjs",
    "test:watch": "vitest",
    "smoke": "npm run build && bash tests/smoke.sh",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@toondepauw/node-zstd": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
